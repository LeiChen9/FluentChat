{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fluentchat-api",
  "main": "worker.py",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["python_workers"],

  // 前端由 Worker 一起发，这样页面和 /token 同源，不需要 CORS，
  // 而且 workers.dev 本身就是 HTTPS，iOS 才拿得到麦克风。
  // 只放 site/：目录指向项目根会把 .env 一起传上去，API key 就公开了。
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  // KV：Web Push 订阅端点存这里，key=端点哈希，value=订阅 JSON
  "kv_namespaces": [
    { "binding": "SUBS", "id": "40f6ba9fc2bc41d98c503f65479d4076" }
  ],
  // 用户私有数据：users.json + {user}/hist|state|subs（backend/auth.py）。
  // 私有 bucket，一律经 Worker 读写，不开公开 URL。
  "r2_buckets": [
    { "binding": "DATA", "bucket_name": "fluentchat-data" }
  ],

  "services": [
    { "binding": "PUSHER", "service": "fluentchat-pusher" }
  ],

  // 离线代打：每 5 分钟一期，先只给心跳断了 7 分钟以上的用户抽签；
  // 消息写进 {user}/hist 镜像，推送通知（3c）之后接。
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // 让 .md 进包。它们会以 JS text 模块形式存在，Python 的 open() 读不到，
  // 所以 prompt 实际用的是 worker.py 里内联的那份（tools/gen_prompts.py 生成）。
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
  ]
}
